# ---------------------------------------------------------------------------
# Clinic Management App - backend configuration
#
# Copy to .env (git-ignored) and adjust. Every variable is prefixed CLINIC_ so
# an unrelated DATABASE_URL already exported on your machine or CI runner can
# never redirect this application at the wrong database.
#
# Precedence: OS environment > .env > defaults in app/config.py
# ---------------------------------------------------------------------------

# --- application ---
CLINIC_APP_ENV=development
CLINIC_DEBUG=true
CLINIC_API_PREFIX=/api
# Only needed if a reverse proxy serves the app under a sub-path, e.g.
# /clinic-api. The docs pages already fall back to X-Forwarded-Prefix and then
# to relative URLs, so this is usually left empty.
CLINIC_ROOT_PATH=

# --- database ---
# Set to true to use local SQLite and ignore DATABASE_URL entirely.
# Flip to false (or remove) to connect to Supabase.
CLINIC_USE_LOCAL_DB=false
# Supabase PostgreSQL pooler — used when USE_LOCAL_DB=false
CLINIC_DATABASE_URL=postgresql+psycopg://postgres.equirpnxujslmkomypnb:!%40Pratik011997@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# Local PostgreSQL (clinic_app schema) with HSR production data — for billing verification:
# CLINIC_USE_LOCAL_DB=false
# CLINIC_DATABASE_URL=postgresql+psycopg://user_pratik01_shankar_b1dced:xgk3i6i6yeCy86tZ5yh-3Y827-2aV44IrYQtfe6TeSQ@memexpaas-postgres:5432/user_pratik01_shankar_b1dced?options=-csearch_path%3Dclinic_app
CLINIC_SQL_ECHO=false
CLINIC_AUTO_CREATE_TABLES=true

# --- auth ---
# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters; the app refuses to start in production otherwise.
CLINIC_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
CLINIC_JWT_ALGORITHM=HS256
CLINIC_ACCESS_TOKEN_EXPIRE_MINUTES=60
CLINIC_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS (comma-separated; must include the frontend origin) ---
CLINIC_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- email provider ---
CLINIC_EMAIL_PROVIDER=msg91

# MSG91 credentials (shared by email and WhatsApp)
CLINIC_MSG91_AUTH_KEY=565807AD7y1pzLM6aa6a8b9P1

# MSG91 Email — fill in your verified sending domain from MSG91 → Email → Sending Domains
CLINIC_MSG91_EMAIL_DOMAIN=mail.paineasy.in
CLINIC_MSG91_EMAIL_FROM=admin@mail.paineasy.in
CLINIC_MSG91_EMAIL_APPT_TEMPLATE_ID=template_13_09_2026_19_09
CLINIC_MSG91_EMAIL_BILL_TEMPLATE_ID=invoice_user_name_paineasy_2

# SMTP fallback (leave blank if using MSG91)
CLINIC_EMAIL_API_KEY=
CLINIC_EMAIL_FROM=no-reply@clinic.example.com
CLINIC_SMTP_HOST=
CLINIC_SMTP_PORT=587
CLINIC_SMTP_USERNAME=
CLINIC_SMTP_PASSWORD=

# --- WhatsApp provider (mock until real credentials exist) ---
CLINIC_WHATSAPP_PROVIDER=mock
CLINIC_WHATSAPP_API_KEY=
CLINIC_WHATSAPP_PHONE_NUMBER_ID=
CLINIC_WHATSAPP_WEBHOOK_VERIFY_TOKEN=paineasy_wa_hook_2026

# --- clinic defaults ---
CLINIC_DEFAULT_SLOT_DURATION_MINUTES=30
CLINIC_DEFAULT_CAPACITY_PER_SLOT=3

# --- seed credentials (development only; change before sharing the app) ---
CLINIC_SEED_SUPERADMIN_USERNAME=superadmin
CLINIC_SEED_SUPERADMIN_PASSWORD=ChangeMe@123
CLINIC_SEED_SUPERADMIN_EMAIL=superadmin@clinic.example.com
CLINIC_SEED_ADMIN_USERNAME=admin
CLINIC_SEED_ADMIN_PASSWORD=ChangeMe@123
CLINIC_SEED_CLINIC_USER_PASSWORD=ChangeMe@123

# ---------------------------------------------------------------------------
# Going live with real messaging
# ---------------------------------------------------------------------------
# Each channel falls back to the mock provider when its credentials are missing,
# with a warning in the log. Nothing is ever silently dropped: every attempt is
# written to `outbound_messages` with its status, recipient and body.

# --- Email: the only channel that needs no external approval ---------------
# CLINIC_EMAIL_PROVIDER=smtp
# CLINIC_SMTP_HOST=smtp.gmail.com
# CLINIC_SMTP_PORT=587            # 465 = implicit TLS, 587 = STARTTLS
# CLINIC_SMTP_USERNAME=clinic@example.com
# CLINIC_SMTP_PASSWORD=            # an APP password, not the account password
# CLINIC_EMAIL_FROM=no-reply@example.com
# CLINIC_EMAIL_FROM_NAME=PainEasy

# --- WhatsApp: needs a Business account and approved templates -------------
# You cannot send free-form text to a patient who has not messaged you in the
# last 24 hours. These four templates must be submitted to Meta and approved
# before any appointment message will deliver:
#
#   appointment_booked        {{1}} clinic  {{2}} date  {{3}} time
#   appointment_rescheduled   {{1}} clinic  {{2}} date  {{3}} time
#   appointment_cancelled     {{1}} clinic  {{2}} date  {{3}} time
#   appointment_missed        {{1}} clinic  {{2}} date  {{3}} time
#
# CLINIC_WHATSAPP_PROVIDER=business_api
# CLINIC_WHATSAPP_API_KEY=
# CLINIC_WHATSAPP_PHONE_NUMBER_ID=
# Point this at your BSP if they proxy the Cloud API (Gupshup, Twilio, 360dialog):
# CLINIC_WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# --- Web Push (VAPID) -------------------------------------------------------
# Generated locally with scripts/generate_vapid_keys.py — never commit these.
CLINIC_VAPID_PRIVATE_KEY=MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgjBuEekcA8CtDfmy8nHssg48EvkbJMNL2kPpVaMv7UIGhRANCAATL2qDI5TFu_06m35oje4pJdB-TY8ct71r09hPVYiMkkUg5RpuJGEdiF34Wbr3zVIclW67ZLv77tJ22o7IuaHkB
CLINIC_VAPID_PUBLIC_KEY=BMvaoMjlMW7_TqbfmiN7ikl0H5Njxy3vWvT2E9ViIySRSDlGm4kYR2IXfhZuvfNUhyVbrtku_vu0nbajsi5oeQE
CLINIC_VAPID_CONTACT_EMAIL=pratik01.shankar@gmail.com

# --- SMS: fallback only, and only after DLT registration -------------------
# Indian operators drop transactional SMS whose sender id and template are not
# registered with them under TRAI's DLT rules. Until that is done, leave this off.
# CLINIC_SMS_FALLBACK_ENABLED=true
# CLINIC_SMS_PROVIDER=http
# CLINIC_SMS_API_URL=https://api.msg91.com/api/v5/flow/
# CLINIC_SMS_API_KEY=
# CLINIC_SMS_SENDER_ID=PAINEZ
# CLINIC_SMS_TEMPLATE_ID=
